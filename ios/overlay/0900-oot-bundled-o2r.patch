+            message(FATAL_ERROR "SOH_OOT_O2R_PATH does not exist: ${SOH_OOT_O2R_PATH}")
+        endif()
+        target_sources(${PROJECT_NAME} PRIVATE "${SOH_OOT_O2R_PATH}" "${SOH_IOS_SHELL_DIR}/SohBundledO2r.m")
+        set_source_files_properties("${SOH_OOT_O2R_PATH}" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
