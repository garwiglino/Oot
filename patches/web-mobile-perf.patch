     // ---- ROM detection helpers ----
 
+    // Anything that isn't an archive is treated as a ROM candidate and validated by content,
+    // since mobile pickers may hand over files with unexpected extensions.
     function isRomFile(name) {
       var ext = name.toLowerCase().split('.').pop();
-      return ext === 'z64' || ext === 'n64' || ext === 'v64';
+      return ext !== 'o2r' && ext !== 'otr';
+    }
+
+    // Converts .v64 (byte-swapped) and .n64 (little-endian) dumps to big-endian .z64 in place.
+    function normalizeRomByteOrder(arrayBuffer) {
+      if (arrayBuffer.byteLength < 0x40 || arrayBuffer.byteLength % 4 !== 0) return arrayBuffer;
+      var bytes = new Uint8Array(arrayBuffer);
+      var magic = new DataView(arrayBuffer).getUint32(0, false);
+      var i, t;
+      if (magic === 0x37804012) { // .v64: swap each 16-bit pair
+        for (i = 0; i < bytes.length; i += 2) {
+          t = bytes[i]; bytes[i] = bytes[i + 1]; bytes[i + 1] = t;
+        }
+      } else if (magic === 0x40123780) { // .n64: reverse each 32-bit word
+        for (i = 0; i < bytes.length; i += 4) {
+          t = bytes[i]; bytes[i] = bytes[i + 3]; bytes[i + 3] = t;
+          t = bytes[i + 1]; bytes[i + 1] = bytes[i + 2]; bytes[i + 2] = t;
+        }
+      }
+      return arrayBuffer;
+    }
+
+    // Big-endian N64 header whose internal title contains "ZELDA".
+    function isOotRom(arrayBuffer) {
+      if (arrayBuffer.byteLength < 0x40) return false;
+      var view = new DataView(arrayBuffer);
+      if (view.getUint32(0, false) !== 0x80371240) return false;
+      var title = '';
+      for (var i = 0; i < 20; i++) title += String.fromCharCode(view.getUint8(0x20 + i));
+      return title.toUpperCase().indexOf('ZELDA') >= 0;
     }
 
