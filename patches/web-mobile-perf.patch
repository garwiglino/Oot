+  <script>
+    // Optional FPS counter, enabled with #fps in the URL. The game renders once per
+    // requestAnimationFrame, so the rAF rate is the rendered frame rate.
+    (function() {
+      if (!/(^|[#&])fps(=|&|$)/.test(window.location.hash)) return;
+      var el = document.createElement('div');
+      el.style.cssText = 'position:fixed;top:4px;left:4px;z-index:9999;padding:2px 6px;' +
+        'font:12px monospace;color:#0f0;background:rgba(0,0,0,.6);border-radius:4px;pointer-events:none';
+      document.body.appendChild(el);
+      var frames = 0, last = performance.now();
+      function tick(now) {
+        frames++;
+        if (now - last >= 1000) {
+          el.textContent = Math.round(frames * 1000 / (now - last)) + ' FPS';
+          frames = 0;
+          last = now;
+        }
+        requestAnimationFrame(tick);
+      }
+      requestAnimationFrame(tick);
+    })();
+  </script>
